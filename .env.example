# NVIDIA_API_KEY: key from https://build.nvidia.com (starts with "nvapi-"). Enables the AI features.
# Put your real key in a local .env file (never commit it) or in the GitHub secret NVIDIA_API_KEY.
NVIDIA_API_KEY=MY_NVIDIA_API_KEY
# NVIDIA_MODEL: any free chat model listed on build.nvidia.com
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
