# BACKEND_URL: address of your deployed AutoResume backend (the `backend/` folder), https only, no trailing slash.
# The phone app uses it for login, cloud sync AND the AI features. The NVIDIA key lives only on that server
# (backend/.env), so no AI key is ever built into the APK. Leave it as is to build an offline-only app.
BACKEND_URL=https://your-backend.example.com
