# NVIDIA_API_KEY: key from https://build.nvidia.com (starts with "nvapi-"). Enables the AI features.
# Put your real key in a local .env file (never commit it) or in the GitHub secret/variable NVIDIA_API_KEY.
NVIDIA_API_KEY=MY_NVIDIA_API_KEY
# NVIDIA_MODEL: leave as "auto". NVIDIA retires free models every few weeks, so the app asks NVIDIA which
# models are live and picks one itself. Only set a model id here if you want to force one.
NVIDIA_MODEL=auto

# BACKEND_URL: address of your deployed AutoResume backend (the `backend/` folder), https only, no trailing slash.
# Leave it as is to build the app without login (offline only).
BACKEND_URL=https://your-backend.example.com
