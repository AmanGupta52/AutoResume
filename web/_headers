/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' https:; frame-src 'self' about: blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
/index.html
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/js/*
  Cache-Control: no-cache
/styles.css
  Cache-Control: no-cache
/landing.css
  Cache-Control: no-cache
/theme.js
  Cache-Control: no-cache
/icons/*
  Cache-Control: public, max-age=31536000, immutable
