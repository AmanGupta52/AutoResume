# ---- Server ----
PORT=4000
NODE_ENV=development
# Set to 1 when the API runs behind a proxy/load balancer (Render, Railway, Nginx...) so rate limits see real IPs.
TRUST_PROXY=0
# Web origins allowed to call the API from a browser, comma separated. Not needed when the web app is served by this server.
CLIENT_ORIGIN=http://localhost:4000

# ---- MongoDB (Atlas connection string or local) ----
MONGODB_URI=mongodb://127.0.0.1:27017/autoresume

# ---- Login tokens ----
# At least 32 random characters. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=30d

# ---- EmailJS (sends the 6-digit codes) ----
# EMAIL_MODE=emailjs sends real emails. EMAIL_MODE=console only prints the codes in the server log (local testing).
EMAIL_MODE=console
APP_NAME=AutoResume
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
